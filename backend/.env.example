DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/voice_meet?schema=public
PORT=4000
# Express "trust proxy": set to "true" (or the number of proxy hops) when the
# backend runs behind a reverse proxy so rate limiting keys on the real client IP.
TRUST_PROXY=
FRONTEND_URL=http://localhost:3000
STUN_SERVER_URL=stun:stun.example.com:3478

# TURN provider: "static" for a self-hosted coturn, "cloudflare" for the managed
# Cloudflare Realtime TURN service. Leave both blocks empty to run STUN only.
TURN_PROVIDER=

# Option 1 - self-hosted coturn using --use-auth-secret. All three are required
# together and cannot be combined with the Cloudflare block.
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# Option 2 - Cloudflare Realtime TURN. Both are required together, and
# TURN_PROVIDER must be "cloudflare". The API token is a secret: server-side only.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_TTL_SECONDS=86400
